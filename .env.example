# Copy to .env.local and fill in values. NEVER commit .env.local.
#
# All variables are OPTIONAL — the app degrades to mock data when
# Supabase / Anthropic are not configured. This keeps preview
# deployments usable before the backend is wired.

# ─── Anthropic (for /api/analyze AI pipeline) ────────────────────
# Without this, /api/analyze returns a deterministic fallback based on
# category. Wizard still works end-to-end.
ANTHROPIC_API_KEY=sk-ant-...

# ─── Supabase ────────────────────────────────────────────────────
# Get these from https://supabase.com/dashboard/project/<project>/settings/api
#
# Public (exposed in browser bundle):
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Server-only (service role — BYPASSES RLS — never expose to client):
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ─── Rate limiting (shared across /api/analyze and /api/match) ───
# Requests per IP per hour. Default: 10.
RATE_LIMIT_MAX=10

# ─── Deployment origin (used for email redirect URLs in prod) ────
# Set to your production URL in Vercel env (e.g. https://twojapomocprawna.pl).
# Only needed if Supabase magic-link redirects must go somewhere other
# than the current origin (e.g. Vercel preview → prod).
NEXT_PUBLIC_SITE_URL=https://twojapomocprawna.pl
